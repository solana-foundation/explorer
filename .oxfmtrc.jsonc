{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "arrowParens": "avoid",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "endOfLine": "lf",
    "jsxSingleQuote": false,
    "printWidth": 120,
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": true,
    "sortPackageJson": false,
    "sortTailwindcss": {
        "config": "./tailwind.config.ts"
    },
    "tabWidth": 4,
    "useTabs": false,
    "overrides": [
        {
            "files": ["*.yaml", "*.yml"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["*.json", "*.md"],
            "options": {
                "singleQuote": false
            }
        },
        {
            "files": ["openspec/**/*.md"],
            "options": {
                "proseWrap": "never"
            }
        },
        // Reflow prose at printWidth so these docs stay readable in a diff and in an editor without soft wrap.
        // Scoped rather than repo-wide: turning it on everywhere would reflow every existing markdown file.
        {
            "files": ["app/mcp/**/*.md"],
            "options": {
                "proseWrap": "always"
            }
        }
    ],
    "ignorePatterns": [
        ".next/",
        ".next-dev/",
        ".vscode",
        "cache/",
        "coverage/",
        "node_modules/",
        "dist/",
        "packages/entity-inspector/",
        "build/",
        ".pnpm-store/",
        ".claude/",
        ".worktrees/",
        "storybook-static/",
        "storybook-static-*/",
        "public/mockServiceWorker.js",
        "packages/idl-decode/",
        "packages/parsers/",
        // markdownlint owns this file; the formatter re-aligns compact tables
        "docs/firewall.md"
    ]
}
