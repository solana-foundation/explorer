{
    "uid": "explorer-logs-absent",
    "title": "explorer: no production logs for 30m",
    "ruleGroup": "explorer-availability",
    "folderUID": "explorer",
    "noDataState": "Alerting",
    "execErrState": "Error",
    "for": "5m",
    "data": [
        {
            "refId": "A",
            "datasourceUid": "grafanacloud-logs",
            "queryType": "range",
            "relativeTimeRange": {
                "from": 2100,
                "to": 0
            },
            "model": {
                "expr": "sum(count_over_time({service=\"explorer\", env=\"prd\"}[30m]))",
                "queryType": "range",
                "refId": "A"
            }
        },
        {
            "refId": "B",
            "datasourceUid": "__expr__",
            "queryType": "",
            "relativeTimeRange": {
                "from": 0,
                "to": 0
            },
            "model": {
                "type": "reduce",
                "refId": "B",
                "expression": "A",
                "reducer": "last",
                "settings": {
                    "mode": "replaceNN",
                    "replaceWithValue": 0
                }
            }
        },
        {
            "refId": "C",
            "datasourceUid": "__expr__",
            "queryType": "",
            "relativeTimeRange": {
                "from": 0,
                "to": 0
            },
            "model": {
                "type": "threshold",
                "refId": "C",
                "expression": "B",
                "conditions": [
                    {
                        "evaluator": {
                            "type": "lt",
                            "params": [1]
                        },
                        "operator": {
                            "type": "and"
                        },
                        "query": {
                            "params": ["B"]
                        },
                        "reducer": {
                            "type": "last",
                            "params": []
                        },
                        "type": "query"
                    }
                ]
            }
        }
    ],
    "condition": "C",
    "labels": {
        "service": "explorer",
        "severity": "warning",
        "slack": "true"
    },
    "annotations": {
        "summary": "explorer log drain has gone quiet",
        "description": "No log lines from Vercel production reached Loki in the last 30 minutes. explorer.solana.com serves traffic continuously, so the Vercel log drain, /api/log-drain, or the Loki push credentials are broken, and every log-based alert is blind until fixed. Check Vercel \u2192 Project \u2192 Log Drains, then the log-drain route's own errors in Sentry. This rule also fires on a Loki query error, since a broken datasource silences the other rules the same way. Ships paused; unpause once the drain is verified.",
        "runbook_url": "https://github.com/solana-foundation/explorer/blob/master/docs/observability.md"
    },
    "notification_settings": {
        "receiver": "explorer-slack"
    },
    "isPaused": true
}
