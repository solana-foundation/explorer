{
    "uid": "explorer-5xx-responses",
    "title": "explorer: 5xx responses",
    "ruleGroup": "explorer-availability",
    "folderUID": "explorer",
    "noDataState": "OK",
    "execErrState": "OK",
    "for": "5m",
    "data": [
        {
            "refId": "A",
            "datasourceUid": "grafanacloud-logs",
            "queryType": "range",
            "relativeTimeRange": {
                "from": 600,
                "to": 0
            },
            "model": {
                "expr": "sum(count_over_time({service=\"explorer\", env=\"prd\"} | json | proxy_statusCode=~\"5..\" [5m]))",
                "queryType": "range",
                "refId": "A"
            }
        },
        {
            "refId": "B",
            "datasourceUid": "__expr__",
            "queryType": "",
            "relativeTimeRange": {
                "from": 0,
                "to": 0
            },
            "model": {
                "type": "reduce",
                "refId": "B",
                "expression": "A",
                "reducer": "last",
                "settings": {
                    "mode": "replaceNN",
                    "replaceWithValue": 0
                }
            }
        },
        {
            "refId": "C",
            "datasourceUid": "__expr__",
            "queryType": "",
            "relativeTimeRange": {
                "from": 0,
                "to": 0
            },
            "model": {
                "type": "threshold",
                "refId": "C",
                "expression": "B",
                "conditions": [
                    {
                        "evaluator": {
                            "type": "gt",
                            "params": [20]
                        },
                        "operator": {
                            "type": "and"
                        },
                        "query": {
                            "params": ["B"]
                        },
                        "reducer": {
                            "type": "last",
                            "params": []
                        },
                        "type": "query"
                    }
                ]
            }
        }
    ],
    "condition": "C",
    "labels": {
        "service": "explorer",
        "severity": "critical",
        "slack": "true"
    },
    "annotations": {
        "summary": "explorer.solana.com is returning 5xx responses",
        "description": "More than 20 requests in the trailing 5 minutes got a 5xx from explorer (Vercel proxy status code, all sources), sustained for 5m. Counts responses, not log lines, so a noisy stack trace cannot trip it. Check the Explorer dashboard: Top paths with 5xx, then Recent errors, then the Vercel deployment logs. A burst that starts within minutes of a deploy and stops on its own is usually one bad function instance during rollout; anything sustained is an outage.",
        "runbook_url": "https://github.com/solana-foundation/explorer/blob/master/docs/observability.md"
    },
    "notification_settings": {
        "receiver": "explorer-slack"
    },
    "isPaused": false
}
