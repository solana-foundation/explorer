{
    "name": "@explorer/decoder-mango",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./detection": {
            "types": "./dist/detection.d.ts",
            "import": "./dist/detection.js",
            "default": "./dist/detection.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@solana-program/token": "0.15.0",
        "typescript": "catalog:tooling",
        "vitest": "catalog:vitest"
    },
    "peerDependencies": {
        "@solana/kit": "^7.0.0",
        "@solana/web3.js": "^1.98.0"
    }
}
